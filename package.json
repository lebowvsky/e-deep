{
  "name": "e-deep",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.18.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" run dev",
    "dev:api": "pnpm --filter @e-deep/api run dev",
    "dev:web": "pnpm --filter @e-deep/web run dev",
    "dev:admin": "pnpm --filter @e-deep/admin run dev",
    "migration:run": "pnpm --filter @e-deep/api run migration:run",
    "migration:revert": "pnpm --filter @e-deep/api run migration:revert",
    "migration:generate": "pnpm --filter @e-deep/api run migration:generate",
    "migration:create": "pnpm --filter @e-deep/api run migration:create",
    "db:seed": "pnpm --filter @e-deep/api run db:seed",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
