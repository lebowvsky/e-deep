# API environment. Copy to `.env` (gitignored) and adjust. Validated at startup (src/config/environment.ts).
PORT=3000

# Must match the database started by the root docker-compose.yml (see the root .env).
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=edeep
DATABASE_PASSWORD=change-me
DATABASE_NAME=edeep

# Comma-separated list of allowed browser origins (web and admin, dev then `vite preview` ports).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173,http://localhost:4174

# Optional: purge horizon of the synchronisation tombstones, in days (default 90, see D-12).
# SYNC_PURGE_HORIZON_DAYS=90

# DEVELOPMENT ONLY, until authentication exists: the current diver is the first one created
# (the seed's Marine Rousseau). Without it, the endpoints that need a diver answer 401.
DEV_AUTH_STUB=true
