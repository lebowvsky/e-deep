# API environment. Copy to `.env` (gitignored) and adjust. Validated at startup (src/config/environment.ts).
PORT=3000

# Required: development, test or production.
NODE_ENV=development

# Optional: number of reverse-proxy hops trusted by Express (`trust proxy`), so that the client
# IP and protocol are read from X-Forwarded-*. Default 0: nothing sits in front of the API in dev.
# TRUST_PROXY=0

# Optional: `Secure` attribute of the session cookie, read from auth lot 3 on (D34). Default true;
# only the exact value `false` disables it. False here because local development runs over http
# (Safari drops `Secure` cookies on http://localhost). Never set it to false in production.
SESSION_COOKIE_SECURE=false

# Optional: opens the sign-up (POST /api/auth/register). Default false (closed beta, D39): the
# endpoint answers 403 registration-closed. Only the exact value `true` enables it. Keep it false
# in production until the email lot (verification, reset, non-enumerating sign-up) is delivered.
# REGISTRATION_ENABLED=false

# Key of the staff TOTP secrets (D42, AES-256-GCM): the base64 of exactly 32 random bytes. Optional
# while no staff account exists; then REQUIRED: the API refuses to boot without it, and the
# commands `account:create-staff` / `account:reset-totp` always require it. One key per environment,
# never committed, never reused across environments. Changing it makes every enrolled secret
# unreadable (each staff account must then be re-enrolled with `account:reset-totp`). Generate one:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# TOTP_ENCRYPTION_KEY=

# Must match the database started by the root docker-compose.yml (see the root .env).
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=edeep
DATABASE_PASSWORD=change-me
DATABASE_NAME=edeep

# Required: comma-separated list of the browser origins accepted on state-changing requests
# (POST, PUT, DELETE) that carry no `Sec-Fetch-Site: same-origin` (OriginGuard, D34): web and admin,
# dev then `vite preview` ports. Bare origins only (no path, no trailing slash). Replaces
# CORS_ORIGINS: there is no CORS any more, each front serves the API on its own origin.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173,http://localhost:4174

# Optional: purge horizon of the synchronisation tombstones, in days (default 90, see D-12).
# SYNC_PURGE_HORIZON_DAYS=90

# Dev seed only (`pnpm db:seed`), required there and nowhere else (not by the API, the migrations
# nor the db tests): password of every seeded account (marine@example.test, lucas@example.test,
# thao@example.test). No default, never logged. At least 15 characters, and it must pass the
# password policy: not a common password, no email nor name of a seeded diver in it.
# The seed replaces the divers, their accounts and dive logs only: staff accounts created with
# `account:create-staff` (and their sessions) are kept across re-seeds.
# SEED_PASSWORD=
