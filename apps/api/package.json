{
  "name": "@e-deep/api",
  "version": "0.0.0",
  "private": true,
  "description": "E-Deep REST API (NestJS, CommonJS).",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --selectProjects unit e2e",
    "test:unit": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --selectProjects unit",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --selectProjects e2e",
    "test:db": "nest build && node --experimental-vm-modules ./node_modules/jest/bin/jest.js --selectProjects db --runInBand",
    "migration:create": "typeorm migration:create",
    "migration:generate": "nest build && typeorm migration:generate -d dist/database/data-source.js",
    "migration:run": "nest build && typeorm migration:run -d dist/database/data-source.js",
    "migration:revert": "nest build && typeorm migration:revert -d dist/database/data-source.js",
    "db:seed": "nest build && node dist/database/seeds/dev-seed.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-express": "^12.4.0",
    "@nestjs/typeorm": "^12.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@e-deep/shared": "workspace:*",
    "@e-deep/tsconfig": "workspace:*",
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.4.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3"
  }
}
