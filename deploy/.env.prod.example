# Production environment of deploy/docker-compose.prod.yml. Copy to deploy/.env.prod (gitignored,
# chmod 600) and fill in. Read by `docker compose --env-file deploy/.env.prod …` only: each service
# receives just its own variables (see the compose file). Never commit real values.

# --- Images ----------------------------------------------------------------------------------------
# Tag of the api and caddy images: set it to the deployed git commit (`git rev-parse --short HEAD`)
# rather than relying on the `latest` fallback. GHCR_OWNER: GitHub owner of the images.
TAG=
# GHCR_OWNER=

# --- Domains ---------------------------------------------------------------------------------------
# Bare host names, no scheme. Locally: localhost and admin.localhost (Caddy internal CA).
WEB_DOMAIN=
ADMIN_DOMAIN=

# --- Admin barrier (Caddy basic_auth, D69) --------------------------------------------------------
# Hash: docker run --rm caddy:2.11-alpine caddy hash-password  (type the password, bcrypt output).
# Keep the single quotes: the hash contains `$`, which compose would otherwise interpolate.
ADMIN_BASIC_AUTH_USER=
ADMIN_BASIC_AUTH_HASH=''

# --- Database (PostgreSQL container, also given to the API) ---------------------------------------
POSTGRES_USER=
# Long and random, e.g. openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- API -------------------------------------------------------------------------------------------
# Key of the staff TOTP secrets (D42): base64 of 32 random bytes, specific to production.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=
# Closed beta: keep false until the email lot (D39).
REGISTRATION_ENABLED=false
